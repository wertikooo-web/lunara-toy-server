# OpenAI — STT (Whisper) + LLM (GPT-4o mini)
OPENAI_API_KEY=sk-...

# Yandex Cloud — TTS (голос Маша)
YANDEX_API_KEY=AQVN...
YANDEX_FOLDER_ID=b1g...

# Публичный URL сервера (Railway даёт автоматически)
PUBLIC_URL=https://your-app.railway.app

# PostgreSQL — Memory v1
DATABASE_URL=postgresql://user:password@host:5432/database
DEFAULT_DEVICE_ID=demo_lumi_001
MEMORY_AUTO_UPDATE=true
MEMORY_EXTRACT_MODEL=gpt-4o-mini
# Включай только если провайдер требует SSL для внешнего подключения
PGSSL=false

PORT=3000
