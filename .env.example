# OpenAI — STT (Whisper) + LLM (GPT-4o mini)
OPENAI_API_KEY=sk-...

# Yandex Cloud — TTS (голос Маша)
YANDEX_API_KEY=AQVN...
YANDEX_FOLDER_ID=b1g...

# Публичный URL сервера (Railway даёт автоматически)
PUBLIC_URL=https://your-app.railway.app

# Persistent audio cache.
# On Railway, mount a Volume and point AUDIO_DIR to it, for example:
# AUDIO_DIR=/data/audio
# If AUDIO_DIR is not set, audio is stored in the app folder and disappears after redeploy.
AUDIO_DIR=

# PostgreSQL — Memory v1
DATABASE_URL=postgresql://user:password@host:5432/database
DEFAULT_DEVICE_ID=demo_lumi_001
MEMORY_AUTO_UPDATE=true
MEMORY_EXTRACT_MODEL=gpt-4o-mini
# Включай только если провайдер требует SSL для внешнего подключения
PGSSL=false

PORT=3000

# Hybrid Semantic Intent Pipeline (content.getSemanticIntent, gpt-4o-mini classifier).
# Выключен по умолчанию — при 'false'/не заданной переменной роутинг идёт только по RegEx,
# классификатор вообще не вызывается. Включай только для тестирования/постепенного роллаута,
# т.к. это доп. вызов OpenAI на каждое сообщение, которое не распознал RegEx.
USE_SEMANTIC_INTENT=false
