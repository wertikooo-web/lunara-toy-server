{

  "$schema": "https://railway.com/railway.schema.json",

  "build": {

    "builder": "RAILPACK"

  },

  "deploy": {

    "startCommand": "node -r ./modules/memoryGuardPreload.js -r ./modules/audioInputGuardPreload.js -r ./modules/contentPacksPreload.js -r ./modules/contentIntentPatch.js -r ./modules/storyContentPatch.js -r ./modules/serverPipelinePatch.js -r ./modules/topicRiddlePatch.js server.js",

    "healthcheckPath": "/health",

    "healthcheckTimeout": 120,

    "restartPolicyType": "ON_FAILURE",

    "restartPolicyMaxRetries": 3

  }

}

{

  "$schema": "https://railway.app/railway.schema.json",

  "build": {

    "builder": "NIXPACKS"

  },

  "deploy": {

    "numReplicas": 1,

    "restartPolicyType": "ON_FAILURE"

  },

  "volumes": [

    {

      "name": "audio-storage",

      "mountPath": "/app/audio"

    }

  ]

}
